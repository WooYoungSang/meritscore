    "prove": "python scripts/prove_merit.py"
  },
  "devDependencies": {
    "circomlib": "^2.0.5",
    "snarkjs": "^0.7.6"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7"
  }
}
