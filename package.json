{
  "name": "warvis-zk",
  "version": "0.1.0",
  "description": "ZK Merit Proof circuits and provers for warvis",
  "scripts": {
    "build:circuits": "circom circuits/merit_threshold.circom --r1cs --wasm --sym -o circuits/",
